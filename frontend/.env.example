# Copy to .env (never commit .env)
# Turso (libSQL over HTTP) used for login + saving lesson results when the Spring Boot backend is not reachable.
# Leave empty to run fully offline (login falls back to a local session).
VITE_TURSO_URL=
VITE_TURSO_TOKEN=

# Spring Boot backend used on localhost (default http://localhost:8080)
VITE_API_BASE_URL=http://localhost:8080

# AI chatbot service (FastAPI + Gemini, default http://localhost:8000)
VITE_AI_BASE_URL=http://localhost:8000
